# Backend
# Local uvicorn: http://localhost:11434
# Docker Compose API container: forced to http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# Must support Ollama tool calling (llama3.2 is a reliable default)
OLLAMA_MODEL=llama3.2

# Sample SQLite database (created on Day 2)
DATABASE_URL=sqlite:///./data/ecommerce.db

# Safety / agent defaults
SQL_ROW_LIMIT=100
SQL_TIMEOUT_SECONDS=10
AGENT_RECURSION_LIMIT=25

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (Vite local dev). Docker build ignores this and uses /api via nginx.
VITE_API_BASE_URL=http://localhost:8000
